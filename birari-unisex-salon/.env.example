# ---------------------------------------------------------------------------
# BIRARI UNISEX SALON — Environment Variables (example)
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ---------------------------------------------------------------------------

# Database (SQLite by default — zero cost, file-based)
DATABASE_URL="file:./dev.db"

# Public site URL (used to build QR codes and shareable links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Salon identity -----------------------------------------------------
SALON_NAME="Birari Unisex Salon"
SALON_LOGO_PATH="/assets/birari-unisex-salon-logo.png"

# --- WhatsApp click-to-chat (NOT WhatsApp Business API — zero cost) -----
# Include country code, digits only, no + sign, no spaces. Example: 919876543210
OWNER_WHATSAPP_NUMBER="919999999999"

# --- Payment instructions (manual UPI — no payment gateway required) ----
UPI_ID="birarisalon@upi"
PHONEPE_NUMBER="9999999999"
GOOGLEPAY_NUMBER="9999999999"
PAYTM_NUMBER="9999999999"
PREBOOKING_AMOUNT="100"

# --- Admin authentication -------------------------------------------------
ADMIN_USERNAME="admin"
# Plain password used only to seed the hashed password on first run.
ADMIN_PASSWORD="ChangeMe@123"
# Secret used to sign/verify admin session tokens. Use a long random string.
ADMIN_SESSION_SECRET="replace-this-with-a-long-random-string"

# --- Optional: future real payment gateway placeholders (unused in demo) --
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# STRIPE_SECRET_KEY=

# --- Optional: Supabase (if you migrate off SQLite later) ---------------
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
